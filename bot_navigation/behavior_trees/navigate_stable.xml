<!--
  Smooth drive + dyn_obs: replan ~1.2 Hz; on stuck STOP → brief wait → backup → clear → replan.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="12" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.2">
          <RecoveryNode number_of_retries="2" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap name="ClearGlobal" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <RecoveryNode number_of_retries="4" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <Sequence name="UnstickLocal">
            <!-- About to hit / stuck: stop (no cmd), wait, back off, clear, replan -->
            <Wait wait_duration="0.55"/>
            <BackUp backup_dist="0.25" backup_speed="0.08"/>
            <ClearEntireCostmap name="ClearLocal" service_name="local_costmap/clear_entirely_local_costmap"/>
            <Wait wait_duration="0.35"/>
          </Sequence>
        </RecoveryNode>
      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="StopClear">
            <Wait wait_duration="0.45"/>
            <ClearEntireCostmap name="ClearLocalRecovery" service_name="local_costmap/clear_entirely_local_costmap"/>
          </Sequence>
          <BackUp backup_dist="0.30" backup_speed="0.09"/>
          <Spin spin_dist="0.7"/>
          <ClearEntireCostmap name="ClearGlobalRecovery" service_name="global_costmap/clear_entirely_global_costmap"/>
          <Wait wait_duration="0.55"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
